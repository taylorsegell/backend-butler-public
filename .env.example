# ---- Home Assistant ----
# Base URL only — the agent appends /api/mcp automatically.
HA_URL=https://your-home-assistant.example.com
HA_TOKEN=your-long-lived-access-token

# ---- LiveKit server (self-hosted or Cloud project) ----
LIVEKIT_URL=wss://your-livekit-server
LIVEKIT_API_KEY=your-api-key
LIVEKIT_API_SECRET=your-api-secret

# Explicit-dispatch name for this worker (must match the "Agent name" configured in the
# Home Assistant integration — see docs/home-assistant.md).
AGENT_NAME=ha-agent

# ---- LiveKit Inference gateway (STT / LLM / TTS) ----
# Used for model access. Falls back to LIVEKIT_URL / LIVEKIT_API_KEY / LIVEKIT_API_SECRET
# if these are unset.
LIVEKIT_INFERENCE_URL=https://agent-gateway.livekit.cloud/v1
LIVEKIT_INFERENCE_API_KEY=your-inference-key
LIVEKIT_INFERENCE_API_SECRET=your-inference-secret

# ---- Scheduling ----
# Home timezone, used to resolve relative schedules ("in 1 hour") and stamp scheduled times.
# An IANA name, e.g. Asia/Shanghai, America/New_York. Falls back to TZ, then UTC.
AGENT_TZ=UTC
# A one-time task whose fire time was missed while the scheduler was down still runs once if
# the outage was within this many seconds; older misses are marked "missed" (default 3600).
# MISFIRE_GRACE_SECONDS=3600
# Shared secret guarding the scheduler's HTTP API, which docker-compose publishes on 8951 for
# the Home Assistant integration. Required: while it is empty the scheduler refuses every
# request but /healthz. The worker reads it from here, and the Home Assistant integration's
# "Scheduler token" must be the same value. Generate one with e.g. `openssl rand -hex 32`.
SCHEDULER_TOKEN=

# ---- Text chat ----
# Service token for the text chat endpoints (POST /chat, and the A2A endpoint behind it on
# /home-assistant). Its holder may act for any person, so give it only to the Home Assistant
# integration ("Agent chat token") and the scheduler, which read it from here. Unset leaves
# the endpoints off; voice is unaffected either way. Generate one with
# `openssl rand -hex 32`.
TEXT_API_TOKEN=
# A token per person for their own clients, e.g. an iPhone Shortcut made with
# scripts/make_shortcut.py: `name=token,name=token`. A request with one always acts for that
# person, whatever `user` it names, and reaches only /chat. Names match the people in the
# card's Settings tab, ignoring case.
# TEXT_USER_TOKENS=alice=<token>,bob=<token>
# Seconds a quiet text conversation stays loaded before it is saved and dropped (default 1800).
# TEXT_IDLE_TIMEOUT=1800
# Seconds without a text turn after which the next one starts a new conversation; unset or 0
# never does, and a new one starts only when asked (the card's Text tab, or "new").
# TEXT_RENEW_AFTER=0
# Chat items a loaded text conversation keeps in the agent's context (default 100).
# TEXT_MAX_ITEMS=100
# Read by ha-notify-scheduler, which shows each text turn's progress on a person's phone.
# A phone's notify service (e.g. mobile_app_my_iphone) to show it on for no one in particular,
# replaced in place; unset turns it off. TEXT_LIVE_MODE: notification (default) or activity
# (a Live Activity; see ha-notify-scheduler/README.md for its limits). TEXT_LIVE_CLEAR_AFTER: seconds
# after the last turn before a Live Activity is cleared. TEXT_LIVE_URL: the page a tap opens.
# TEXT_LIVE_ACTIVITY=
# TEXT_LIVE_MODE=notification
# TEXT_LIVE_CLEAR_AFTER=900
# TEXT_LIVE_URL=/dashboard-name/view?lk_tab=text

# ---- MCP servers ----
# agent/mcp.yaml lists the MCP servers besides Home Assistant's and reads their keys from
# here; a server whose keys are unset is skipped. AGENT_MCP_CONFIG / AGENT_PROMPT point
# docker-compose at your own copies of mcp.yaml and prompt.yaml, e.g. agent/*.local.yaml.
# AGENT_MCP_CONFIG=./agent/mcp.local.yaml
# AGENT_PROMPT=./agent/prompt.local.yaml
# Web search: Parallel Search works anonymously; a key raises its limits.
# PARALLEL_API_KEY=
# WEB_SEARCH_URL=https://search.parallel.ai/mcp
# Memory: a Mem0 API key (https://app.mem0.ai) turns on long-term memory.
# MEM0_API_KEY=
# Coding agents: a herdr-mcp-server (https://github.com/taylorsegell/herdr-mcp-server). Only
# people whose Settings entry lists "herdr" under servers can use it.
# HERDR_MCP_URL=http://<computer-running-herdr>:8960/mcp
# This agent's HTTP app as MCP servers reach it. A server with callback: true in mcp.yaml
# POSTs a long task's result to /chat/events here, which needs TEXT_API_TOKEN.
# CALLBACK_BASE_URL=http://<agent-host>:8952
# Backend Butler: the app's bridge port and its api_token option (same value in both
# places). Updates come back through CALLBACK_BASE_URL, so set that too.
# BUTLER_MCP_URL=http://<home-assistant-host>:8098/mcp
# BUTLER_API_TOKEN=

# ---- Optional model overrides (the values shown are the defaults) ----
# STT_MODEL=assemblyai/universal-3-5-pro
# STT_LANGUAGE=multi
# LLM_MODEL=google/gemma-4-31b-it
# Serve LLM_MODEL from an OpenAI-compatible endpoint instead of LiveKit Inference.
# LLM_EXTRA_BODY is JSON merged into each request, e.g. to turn DeepSeek's thinking off.
# LLM_MODEL=deepseek-flash
# LLM_BASE_URL=https://api.deepseek.com
# LLM_API_KEY=
# LLM_EXTRA_BODY={"thinking": {"type": "disabled"}}
# LLM calls a turn may chain through tools before it must answer (default 6).
# MAX_TOOL_STEPS=6
# TTS_MODEL=fishaudio/s2.1-pro
# TTS_VOICE=5c353fdb312f4888836a9a5680099ef0
# TTS_LANGUAGE=

# ---- Advanced (defaults suit docker-compose) ----
# Home Assistant MCP tools the model never sees.
# HA_HIDDEN_TOOLS=GetDateTime,HassBroadcast,HassCancelAllTimers
# Seconds of silence before a voice session stops paying for speech-to-text.
# STT_IDLE_TIMEOUT=120
# Seconds a waiting /chat request waits for its reply; keep it under any proxy's timeout.
# TEXT_REPLY_TIMEOUT=80
# Where the worker reaches the scheduler, and the scheduler the worker's /chat.
# SCHEDULER_URL=http://ha-notify-scheduler:8080
# AGENT_CHAT_URL=http://agent:8081/chat
# Seconds a scheduled instruction may run before it counts as failed.
# SCHEDULED_RUN_TIMEOUT=200
# Paths and ports inside the containers, set by docker-compose; change them only when
# running outside it: HTTP_PORT (8081), TEXT_DATA_DIR (/data), PROMPT_FILE and MCP_CONFIG
# (agent/prompt.yaml, agent/mcp.yaml), SCHEDULER_DB (/data/scheduler.db), PORT (8080).
